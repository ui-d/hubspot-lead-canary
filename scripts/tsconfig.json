{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "./*.ts",
    "../src/lib/hubspot.ts",
    "../src/lib/hubspot-paths.ts",
    "../src/lib/http.ts",
    "../src/types.ts"
  ]
}
